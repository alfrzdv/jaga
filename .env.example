# Salin ke .env lalu isi. .env masuk .gitignore.

# Telegram
TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=

# Gateway API (127.0.0.1 saja)
GATEWAY_PORT=8787
# token acak panjang, dipakai n8n di header X-Gateway-Token
GATEWAY_TOKEN=

# Data runtime, default ~/.jaga
JAGA_HOME=

# Worker
# path CLI claude; untuk tes bisa diarahkan ke tests/fake_claude.py
CLAUDE_BIN=claude
# hasil `claude setup-token` (§5.1). Wajib.
CLAUDE_CODE_OAUTH_TOKEN=
WORKER_TIMEOUT_S=180
# batas harian per kind, format kind=angka dipisah koma
DAILY_LIMITS=summarize=40,chat=30

# Notifikasi (jam lokal laptop)
QUIET_HOURS=23-6
DIGEST_EVERY_HOURS=6
MORNING_DIGEST_HOUR=7

# Retensi payload dan chat_messages
RETENTION_DAYS=30
# job `diproses` yang lebih tua dari ini di-reset ke `baru` saat start
STALE_MINUTES=15
